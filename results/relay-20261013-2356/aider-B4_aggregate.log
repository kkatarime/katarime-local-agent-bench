New file `aggregate_sales.py` at project root:
```
import csv
from collections import defaultdict
from pathlib import Path

sales_dir = Path(__file__).resolve().parent / "sales"
totals = defaultdict(int)

for csv_path in sorted(sales_dir.glob("*.csv")):
    if csv_path.name == "summary.csv":
        continue
    with csv_path.open(encoding="utf-8") as f:
        for row in csv.DictReader(f):
            totals[row["category"]] += int(row["amount"])

out_path = Path(__file__).resolve().parent / "summary.csv"
with out_path.open("w", encoding="utf-8", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["category", "total"])
    for category, total in sorted(totals.items(), key=lambda item: item[1], 
reverse=True):
        writer.writerow([category, total])
```
