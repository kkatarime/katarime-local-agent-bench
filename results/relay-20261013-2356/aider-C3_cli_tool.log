```python
import sys
import json
from collections import Counter

def compute(text):
    words = text.split()
    counts = Counter(word.lower() for word in words)
    top = sorted(counts.items(), key=lambda item: (-item[1], item[0]))[:5]
    return {
        "lines": len(text.splitlines()),
        "words": len(words),
        "chars": len(text),
        "top": [[word, count] for word, count in top],
    }

def main(argv=None):
    if argv is None:
        argv = sys.argv
    if len(argv) < 2:
        print("usage: python wordstat.py <file>", file=sys.stderr)
        return 1
    with open(argv[1], encoding="utf-8") as f:
        text = f.read()
    print(json.dumps(compute(text), ensure_ascii=False, separators=(",", ":")))
    return 0

if __name__ == "__main__":
    sys.exit(main())
```

