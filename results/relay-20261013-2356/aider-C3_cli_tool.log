Need tests/test_wordstat.py:
```python
import contextlib
import io
import json
import os
import sys
import tempfile
import unittest

sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), 
"..")))

import wordstat


class WordStatTests(unittest.TestCase):
    def test_compute_basic(self):
        text = "Hello hello\nWorld\n"
        result = wordstat.compute(text)
        self.assertEqual(result["lines"], 2)
        self.assertEqual(result["words"], 3)
        self.assertEqual(result["chars"], len(text))
        self.assertEqual(result["top"], [["hello", 2], ["world", 1]])

    def test_compute_top_sorting_and_limit(self):
        text = "a b c d e f a b c d e a b c d a b c a b a"
        result = wordstat.compute(text)
        self.assertEqual(result["top"], [["a", 6], ["b", 5], ["c", 4], ["d", 
3], ["e", 2]])

    def test_main_no_args(self):
        with contextlib.redirect_stderr(io.StringIO()) as err:
            code = wordstat.main(["wordstat.py"])
        self.assertEqual(code, 1)
        self.assertIn("usage", err.getvalue())

    def test_main_file(self):
        text = "Hello hello\nWorld\n"
        with tempfile.NamedTemporaryFile("w", encoding="utf-8", delete=False) 
as f:
            f.write(text)
            path = f.name
        try:
            with contextlib.redirect_stdout(io.StringIO()) as out:
                code = wordstat.main(["wordstat.py", path])
            self.assertEqual(code, 0)
            data = json.loads(out.getvalue())
            self.assertEqual(data["lines"], 2)
            self.assertEqual(data["words"], 3)
            self.assertEqual(data["chars"], len(text))
            self.assertEqual(data["top"], [["hello", 2], ["world", 1]])
        finally:
            os.unlink(path)


if __name__ == "__main__":
    unittest.main()
```

