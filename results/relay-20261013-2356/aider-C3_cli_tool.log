Need think about exact implementation. wordstat.py:
import sys, json, collections
def compute(text):
    lines = len(text.splitlines())
    words = text.split()
    chars = len(text)
    counts = collections.Counter(w.lower() for w in words)
    top = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))[:5]
    return {"lines": lines, "words": len(words), "chars": chars, "top": top}
def main(argv=None):
    argv = sys.argv if argv is None else argv
    if len(argv) < 2:
        print("usage: python wordstat.py <file>", file=sys.stderr)
        return 1
    path = argv[1]
    with open(path, encoding="utf-8") as f:
        text = f.read()
    result = compute(text)
    print(json.dumps(result, ensure_ascii=False))
    return 0
if __name__ == "__main__":
    sys.exit(main())

